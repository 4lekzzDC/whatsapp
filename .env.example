# ============================================================
# FalaHub — variáveis de ambiente
#
# Copie para .env (NUNCA COMMITE .env):
#   cp .env.example .env
# ============================================================

# ---------------- App ----------------
NODE_ENV=production
# URL pública canônica do produto (vista pelo usuário).
APP_URL=https://noratech.com.br/painel/falahub
# Subpath onde a app fica montada. Lido em build time pelo next.config.ts.
# Em dev local, deixe vazio (BASE_PATH=) para a app ficar em http://localhost:3000/.
# Em produção: BASE_PATH=/painel/falahub
BASE_PATH=/painel/falahub
# Use openssl rand -hex 64 para gerar
JWT_SECRET=

# ---------------- Postgres ----------------
# Formato: postgres://user:pass@host:port/dbname
DATABASE_URL=postgres://whatsapp:TROQUE_ESSA_SENHA@127.0.0.1:5432/whatsapp

# ---------------- WhatsApp Cloud API ----------------
# Obtido em developers.facebook.com > seu App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token permanente (do System User). NUNCA use o temporário de 24h em produção.
WHATSAPP_ACCESS_TOKEN=
# Você inventa — precisa bater com o que configurar no painel do Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Usado para validar a assinatura HMAC dos webhooks.
# Obtido em developers.facebook.com > seu App > Configurações > Básico > Chave Secreta do App
WHATSAPP_APP_SECRET=
# Versão da Graph API. Atualize periodicamente.
WHATSAPP_GRAPH_VERSION=v21.0
