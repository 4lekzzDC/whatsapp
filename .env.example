# Supabase — MESMAS credenciais do projeto Supabase do Noratech
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URLs públicas
NEXT_PUBLIC_APP_URL=https://falahub.noratech.com.br
NEXT_PUBLIC_NORATECH_URL=https://noratech.com.br

# Domínio do cookie de sessão Supabase compartilhado entre Noratech e Falahub.
# Em dev pode-se deixar vazio para usar o default ".noratech.com.br";
# para teste local cross-port, deixar como "localhost".
NEXT_PUBLIC_COOKIE_DOMAIN=.noratech.com.br

# Quando "true", o painel exige uma linha em public.entitlements
# (user_id, product='falahub', status in ('active','trial')) para liberar
# acesso. Manter "false" enquanto a tabela não estiver populada.
FALAHUB_REQUIRE_ENTITLEMENT=false

# Service role key do Supabase (somente server). Usada pelo
# /api/whatsapp/webhook para atualizar conexões sem passar pela RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API — roda na mesma VPS atrás de https://evo.noratech.com.br.
# Internamente chamamos o localhost pra evitar voltar pelo Nginx/TLS.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Runtime
NODE_ENV=production
PORT=3000
