# ============================================================
# nginx reverse proxy para o painel WhatsApp Bot
#
# Copie para /etc/nginx/sites-available/painel.noratech.com.br
# Symlink para sites-enabled/, nginx -t, systemctl reload nginx.
# Depois:  certbot --nginx -d painel.noratech.com.br
# ============================================================

# Redirect HTTP → HTTPS (o certbot ajusta depois, mas deixa aqui pra começar)
server {
    listen 80;
    listen [::]:80;
    server_name painel.noratech.com.br;

    # Necessário para o Certbot validar o domínio via HTTP-01.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name painel.noratech.com.br;

    # Os certificados reais são escritos pelo certbot. As linhas abaixo
    # são placeholders — descomente e ajuste se estiver configurando
    # manualmente; caso contrário o certbot injeta sozinho.
    # ssl_certificate     /etc/letsencrypt/live/painel.noratech.com.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/painel.noratech.com.br/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Segurança básica
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Limite de upload (Meta envia mídia até ~16MB)
    client_max_body_size 20m;

    # O webhook do Meta precisa responder rápido (< 10s).
    # Timeout generoso nas rotas de API para SSE/streaming.
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host  $host;
    # SSE:
    proxy_buffering    off;
    proxy_cache        off;
    proxy_set_header   Connection        "";
    proxy_read_timeout 24h;

    # Next.js ouve em localhost:3000 (PM2 config)
    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
